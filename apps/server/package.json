{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "dev": "bun --watch src/index.ts",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "test:http": "test -n \"$DATABASE_URL\" || (echo 'DATABASE_URL must point to an isolated PostgreSQL database' >&2; exit 1); bun run --cwd ../prefill-mock build && bun test --timeout 120000 test/http.test.ts",
    "test:storage": "bun test --timeout 120000 test/storage.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@elysiajs/cors": "^1.4.2",
    "@onlyoffice/auth": "workspace:*",
    "@onlyoffice/db": "workspace:*",
    "@onlyoffice/env": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "elysia": "^1.4.29",
    "fflate": "^0.8.3",
    "saxes": "^6.0.0",
    "typebox": "1.3.34",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@onlyoffice/config": "workspace:*",
    "@types/bun": "catalog:",
    "prefill-mock": "workspace:*",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  }
}
