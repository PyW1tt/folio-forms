NODE_ENV=development
DATABASE_URL=postgresql://folio:folio-local-db-password-2026@localhost:5433/folio_forms
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
EDITOR_CAPABILITY_SECRET=replace-with-a-distinct-editor-capability-secret
PREFILL_HANDOFF_SECRET=replace-with-a-distinct-prefill-handoff-secret
PREFILL_RETURN_URL=http://localhost:3010/return
ONLYOFFICE_JWT_SECRET=replace-with-a-distinct-onlyoffice-jwt-secret

# Optional legacy SSO. Set all six values to enable; use test-only values locally.
LEGACY_SSO_AUTHORIZE_URL=
LEGACY_SSO_CALLBACK_URL=
LEGACY_SSO_CLIENT_ID=
LEGACY_SSO_CLIENT_SECRET=
LEGACY_SSO_EXCHANGE_URL=
LEGACY_SSO_PROVIDER_ID=
# Optional one-time bootstrap for the first Admin. Set all three before first startup, then remove them.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BETTER_AUTH_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
SERVER_ORIGIN=http://localhost:8080
API_BASE=http://localhost:8080
ONLYOFFICE_URL=http://localhost:8080/office
ONLYOFFICE_API_BASE=http://localhost:8080/office
ONLYOFFICE_INTERNAL_URL=http://localhost:8081
ONLYOFFICE_DOCUMENT_BASE_URL=http://host.docker.internal:3000
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY_ID=folioforms-local
RUSTFS_SECRET_ACCESS_KEY=local-rustfs-secret-012345678901234567890123456789
RUSTFS_BUCKET=folio-forms
RUSTFS_REGION=us-east-1
TEMPLATE_PATH=../../onlyoffice-templates/template.docx
