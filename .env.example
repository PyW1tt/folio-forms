POSTGRES_DB=folio_forms
POSTGRES_USER=folio
POSTGRES_PASSWORD=folio-local-db-password-2026
DATABASE_URL=postgresql://folio:folio-local-db-password-2026@postgres:5432/folio_forms

BETTER_AUTH_SECRET=local-auth-secret-012345678901234567890123456789
EDITOR_CAPABILITY_SECRET=local-editor-secret-012345678901234567890123456789
PREFILL_HANDOFF_SECRET=local-prefill-secret-012345678901234567890123456789
ONLYOFFICE_JWT_SECRET=local-onlyoffice-jwt-012345678901234567890123456789

# Optional legacy SSO. Set all six values to enable; never commit real credentials.
LEGACY_SSO_AUTHORIZE_URL=
LEGACY_SSO_CALLBACK_URL=
LEGACY_SSO_CLIENT_ID=
LEGACY_SSO_CLIENT_SECRET=
LEGACY_SSO_EXCHANGE_URL=
LEGACY_SSO_PROVIDER_ID=

# Optional AI Authoring. Configure in local .env after provisioning a permitted service credential and model alias; never commit credentials.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=

RUSTFS_ACCESS_KEY_ID=folioforms-local
RUSTFS_SECRET_ACCESS_KEY=local-rustfs-secret-012345678901234567890123456789
RUSTFS_BUCKET=folio-forms
RUSTFS_REGION=us-east-1

GATEWAY_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
PREFILL_RETURN_URL=http://localhost:3010/return
FOLIO_ORIGIN=http://server:3000

BOOTSTRAP_ADMIN_NAME=Local Admin
BOOTSTRAP_ADMIN_EMAIL=admin@admin.test
BOOTSTRAP_ADMIN_PASSWORD=LocalAdmin-password-2026-long
